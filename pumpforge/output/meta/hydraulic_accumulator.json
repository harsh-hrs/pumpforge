    "pressure": {
      "file": "hydraulic_accumulator_pressure.glb",
      "title": "Gas and oil at the same pressure",
      "description": "The bladder separates nitrogen from oil but transmits pressure, so gas and oil are always at the same pressure. Before any oil enters, the gas is at the pre-charge pressure p₀ (bladder type: typically about 90 % of the minimum system pressure). Oil enters as the system pressure rises, compressing the gas (p·V = constant for slow, isothermal changes; p·V^1.4 for fast, adiabatic ones). The usable oil volume is the gas volume change between maximum and minimum system pressure.",
      "render": "normal",
      "annotations": [
        {
          "text": "N₂ pre-charge p₀ ≈ 0.9 × p_min (bladder, rule of thumb)",
          "anchor": [
            0.0,
            0.99,
            -0.0
          ]
        },
        {
          "text": "ΔV = V₁ − V₂ between p_min and p_max",
          "anchor": [
            0.17,
            0.27,
            -0.0
          ]
        }
      ]
    }
  },
