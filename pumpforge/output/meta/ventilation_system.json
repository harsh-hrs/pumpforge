    "pressure": {
      "file": "ventilation_system_pressure.glb",
      "title": "Air changes, dilution and pressurisation",
      "description": "Ventilation removes heat and dilutes contaminants: rooms are designed for an air-change rate (e.g. ≈ 6–12 per hour, or by heat load Q = P / (ρ·cp·ΔT)) and, in hazardous areas, enough dilution to keep gas below a fraction of its LEL. Supply slightly exceeding exhaust keeps electrical and control rooms at positive pressure (≈ 25–50 Pa) so dust and flammable gas cannot enter; low-level exhaust removes heavier-than-air vapours. Fire dampers close on fire alarm.",
      "render": "normal",
      "annotations": []
    }
