    "temperature": {
      "file": "desilication_tank_temperature.glb",
      "title": "Removing reactive silica before digestion",
      "description": "Kaolinite and other reactive silica dissolve in caustic liquor and would later precipitate as scale or contaminate the product. Holding the slurry at about 95–100 °C for several hours (often ~ 6–10 h) lets the silica re-precipitate as sodalite (desilication product, DSP), which leaves with the red mud. Each kg of reactive silica locks up caustic soda and alumina in DSP.",
      "render": "normal",
      "annotations": []
    }
