    "pressure": {
      "file": "expansion_coupling_pressure.glb",
      "title": "Teeth transmit torque and let the shaft slide",
      "description": "Torque passes from the driver hub teeth to the sleeve and on to the driven hub teeth. Because the teeth can slide axially in the sleeve, the driven shaft is free to grow with temperature (animation shows axial float) without loading the bearings, and the crowned teeth accept small angular and offset misalignment. Sliding under torque needs lubrication — gear couplings are greased or oil-fed; dry teeth wear quickly and can lock, transmitting large thrust. (Pipework \"expansion couplings\" are a different item.)",
      "render": "normal",
      "annotations": []
    },
    "thrust": {
      "file": "expansion_coupling_thrust.glb",
      "title": "Thermal growth",
      "description": "The driven shaft grows axially; the coupling slides instead of pushing on the bearings.",
      "render": "normal",
      "annotations": []
    }
  },
