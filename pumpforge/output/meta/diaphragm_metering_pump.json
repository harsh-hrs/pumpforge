    "stroke_mm_display": 16.0,
    "valves": "Double ball check valves (suction and discharge)",
    "diaphragm": "PTFE (sandwich design with leak detection is common)",
    "capacity_formula": "Q = (stroke volume × stroke % setting) × strokes per minute"
  },
