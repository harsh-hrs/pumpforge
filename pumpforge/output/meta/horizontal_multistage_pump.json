  "components": {
    "impeller_closed": {
      "function": "Adds energy to the liquid; blades between hub and shrouds accelerate the liquid outward.",
      "construction": "Enclosed impeller (front and back shrouds) keyed and locked on the shaft; balance holes and back wear ring reduce axial thrust.",
      "material": "Cast iron, bronze, stainless steel (CF8M, CA6NM), duplex.",
      "operating_conditions": "Head varies with tip speed squared; operation far from BEP increases recirculation, vibration and NPSH required.",
      "failure_modes": [
        "Cavitation damage at blade inlet",
        "Erosion",
        "Imbalance",
        "Wear-ring rub"
      ],
      "inspection": [
        "Inlet edges for pitting",
        "Wear-ring clearance",
        "Balance check after repair"
      ]
    },
    "bfp_stage": {
      "function": "One pumping stage: diffuser recovers pressure from the impeller discharge; return vanes guide water to the next impeller eye.",
      "construction": "Cast or forged ring with diffuser vanes, diaphragm and return channel; metal-to-metal fits with O-rings.",
      "material": "Chrome steel (13 % Cr), carbon steel, stainless.",
      "operating_conditions": "Pressure rises stage by stage; thermal transients must be limited (warm-up).",
      "failure_modes": [
        "Erosion at diffuser tips",
        "Interstage leakage"
      ],
      "inspection": [
        "Clearances at overhaul"
      ]
    },
    "bfp_suction": {
      "function": "Receives feedwater from the deaerator/booster and feeds the first-stage impeller.",
      "construction": "Casting with suction nozzle, foot and first-stage eye passage.",
      "material": "Carbon steel/chrome steel.",
      "operating_conditions": "Hot, near-saturated water — low NPSHa.",
      "failure_modes": [
        "Cavitation erosion at first stage"
      ],
      "inspection": [
        "First-stage impeller inspection"
      ]
    },
    "bfp_discharge": {
