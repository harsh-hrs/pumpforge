    "pressure": {
      "file": "centralized_lubrication_system_pressure.glb",
      "title": "One pump, many points, guaranteed sequence",
      "description": "A progressive divider has pistons that must each complete their stroke before the next can move, so every outlet receives its measured dose in turn. If any line or bearing blocks, the whole divider stops, pressure rises and the cycle indicator / pressure switch raises an alarm — a blocked point cannot go unnoticed. The controller runs short pump cycles followed by pauses, delivering small, frequent doses that suit bearings better than large manual shots.",
      "render": "normal",
      "annotations": []
    }
