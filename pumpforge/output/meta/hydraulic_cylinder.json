    "pressure": {
      "file": "hydraulic_cylinder_pressure.glb",
      "title": "Pressure while extending",
      "description": "Extending: port A feeds the cap end (red, system pressure) and port B returns oil from the rod end (blue, low). Push force F = p × A_bore. Retracting reverses the ports: the pull force is p × (A_bore − A_rod), smaller, but the rod moves faster for the same pump flow because the annulus volume is smaller.",
      "render": "normal",
      "annotations": [
        {
          "text": "Cap end: F_extend = p · π D²/4",
          "anchor": [
            -0.45,
            0.12,
            -0.0
          ]
        },
        {
          "text": "Rod end (annulus): F_retract = p · π (D² − d²)/4",
          "anchor": [
            0.35,
            0.5,
            -0.0
          ]
        }
      ]
    }
