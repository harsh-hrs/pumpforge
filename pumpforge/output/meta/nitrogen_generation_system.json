    "pressure": {
      "file": "nitrogen_generation_system_pressure.glb",
      "title": "Kinetic separation by pressure swing",
      "description": "Carbon molecular sieve separates by speed, not equilibrium: O₂ molecules (≈ 0.346 nm) diffuse into the pores much faster than N₂ (≈ 0.364 nm). With feed air at ≈ 7–10 bar(g) the CMS takes up O₂ in the short cycle (≈ 60 s) and N₂ passes through as product (purity typically 95 – 99.999 %). The tower is then depressurised to atmosphere, releasing the O₂-rich gas, while the other tower takes over; a pressure-equalisation step between towers saves air.",
      "render": "normal",
      "annotations": []
    }
  },
