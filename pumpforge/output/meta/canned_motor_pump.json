  "components": {
    "volute_casing": {
      "function": "Collects flow leaving the impeller and converts velocity into pressure in a spiral passage of increasing area, then discharges through a diffuser nozzle.",
      "construction": "Single-volute casing with cutwater (tongue), suction and discharge nozzles and feet; double-volute designs balance radial load on larger pumps.",
      "material": "Cast iron, ductile iron, carbon steel, stainless steel (CF8M), duplex.",
      "operating_conditions": "Radial load is minimum near BEP and rises at low or high flow.",
      "failure_modes": [
        "Erosion/corrosion at cutwater",
        "Cracking from water hammer or nozzle loads",
        "Wear-ring seat wear"
      ],
      "inspection": [
        "Wall thickness at overhaul",
        "Cutwater condition",
        "Nozzle load and pipe support check"
      ]
    },
    "impeller_closed": {
      "function": "Adds energy to the liquid; blades between hub and shrouds accelerate the liquid outward.",
      "construction": "Enclosed impeller (front and back shrouds) keyed and locked on the shaft; balance holes and back wear ring reduce axial thrust.",
      "material": "Cast iron, bronze, stainless steel (CF8M, CA6NM), duplex.",
      "operating_conditions": "Head varies with tip speed squared; operation far from BEP increases recirculation, vibration and NPSH required.",
