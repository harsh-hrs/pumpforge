    "pressure": {
      "file": "closed_drain_system_pressure.glb",
      "title": "Hydrocarbons never see the atmosphere",
      "description": "A closed drain system collects pressurised or hazardous liquids drained from equipment (maintenance, start-up, level controller drains) in a closed drum that is vented to the flare, so vapours are not released to air and oxygen cannot get in. The drum sits low so drains flow by gravity; the header has no pockets. Closed and open drain systems must never be interconnected (vapour/fire spread).",
      "render": "normal",
      "annotations": []
    }
