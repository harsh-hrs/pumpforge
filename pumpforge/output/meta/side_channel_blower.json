        "Check foot shims for soft foot",
        "Insulation resistance before start-up"
      ]
    },
    "stator": {
      "function": "Produces the rotating magnetic field.",
      "construction": "Laminated electrical-steel core with insulated copper windings; end turns project at each end.",
      "material": "Silicon electrical steel, copper magnet wire, Class F/H insulation (typical).",
      "operating_conditions": "Rated voltage and frequency; temperature rise within insulation class.",
      "failure_modes": [
        "Winding insulation failure",
        "Single phasing",
        "Overload overheating"
      ],
      "inspection": [
        "Insulation resistance / polarisation index",
        "Phase current balance",
        "Winding temperature where RTDs fitted"
      ]
    },
    "rotor": {
      "function": "Converts the rotating field into shaft torque (squirrel-cage induction rotor).",
      "construction": "Laminated core with aluminium or copper bars and end rings, shrunk on the shaft and dynamically balanced.",
      "material": "Electrical steel, die-cast aluminium or copper.",
      "operating_conditions": "Runs slightly below synchronous speed (slip).",
      "failure_modes": [
        "Broken rotor bars",
        "Imbalance",
        "Rotor-stator rub after bearing failure"
      ],
      "inspection": [
        "Motor current signature analysis",
        "Vibration at 1x and pole-pass sidebands"
      ]
    },
    "motor_bearings": {
