    "beta_ratio": "≈ 0.6 (d/D)",
    "equation": "q_m = C/√(1−β⁴) · ε · (π/4)d² · √(2ΔP·ρ1)",
    "straight_runs": "Required upstream/downstream lengths per ISO 5167-2 tables"
  },
