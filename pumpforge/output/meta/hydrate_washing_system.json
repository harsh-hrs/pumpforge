    "pressure": {
      "file": "hydrate_washing_system_pressure.glb",
      "title": "Counter-current washing lowers soda in the hydrate",
      "description": "Fresh hot condensate washes the cake in the last zone; its filtrate is used to wash the previous zone, and so on (counter-current). Soda in the cake falls zone by zone (red → blue) using little water. Low soda in the hydrate is essential because sodium ends up in the smelter-grade alumina product (typical spec ≲ 0.3–0.4 % Na₂O).",
      "render": "normal",
      "annotations": []
    }
