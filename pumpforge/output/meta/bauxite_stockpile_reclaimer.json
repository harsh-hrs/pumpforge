    "pressure": {
      "file": "bauxite_stockpile_reclaimer_pressure.glb",
      "title": "Why full-face reclaiming blends the bauxite",
      "description": "The pile is stacked in many thin layers (chevron) along its length, each layer slightly different in quality. Raking the whole cross-section at once takes a slice of every layer, so the reclaimed bauxite has a much more uniform alumina, silica and moisture content — critical for stable digestion (blending ratio often 5:1 or better).",
      "render": "normal",
      "annotations": []
    }
