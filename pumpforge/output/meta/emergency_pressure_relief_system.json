    "pressure": {
      "file": "emergency_pressure_relief_system_pressure.glb",
      "title": "Relieve before the vessel is overstressed",
      "description": "Every pressure vessel needs relief for its credible overpressure scenarios (blocked outlet, fire, control-valve failure, runaway reaction). A PSV is set at or below the MAWP and sized for the worst relieving rate; allowable accumulation is typically 10 % (single valve), 16 % (multiple) or 21 % (fire case) above MAWP (ASME VIII / API 520 — verify edition). Inlet pressure loss should stay below ≈ 3 % of set pressure to avoid chatter. The change-over valve allows testing a spare without losing protection.",
      "render": "normal",
      "annotations": []
    }
