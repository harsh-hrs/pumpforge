    "mechanical_seal": {
      "function": "Seals the rotating shaft where it leaves the pressurised casing.",
      "construction": "Spring-loaded rotating face running against a stationary seat; secondary elastomer seals; cartridge designs are pre-set for easier installation.",
      "material": "Faces: carbon-graphite, silicon carbide, tungsten carbide; metal parts stainless steel; elastomers per fluid.",
      "operating_conditions": "Faces need a stable liquid film; flush or quench piping plans (API 682 plan numbers) are chosen to control temperature, pressure and solids at the faces.",
      "failure_modes": [
        "Dry running",
        "Face wear from abrasives",
        "Thermal cracking",
        "Elastomer chemical attack",
        "Excess shaft run-out or vibration"
      ],
      "inspection": [
        "Leakage rate and seal temperature",
        "Flush flow/pressure where fitted",
        "Shaft run-out at seal chamber"
      ]
    },
    "motor_stand": {
      "function": "Supports the vertical motor and aligns it to the pump; windows give access to coupling and seal.",
      "construction": "Cast lantern with machined registers.",
      "material": "Cast iron.",
      "operating_conditions": "Carries motor weight and torque reaction.",
      "failure_modes": [
        "Register damage causing misalignment",
        "Structural resonance"
      ],
      "inspection": [
