      "operating_conditions": "Pipe loads act directly on the pump; piping must be supported either side.",
      "failure_modes": [
        "Nozzle overload from pipe strain",
        "Erosion at cutwater"
      ],
      "inspection": [
        "Pipe supports",
        "Wall thickness"
      ]
    },
