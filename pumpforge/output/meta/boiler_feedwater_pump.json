  "components": {
    "impeller_closed": {
      "function": "Adds energy to the liquid; blades between hub and shrouds accelerate the liquid outward.",
      "construction": "Enclosed impeller (front and back shrouds) keyed and locked on the shaft; balance holes and back wear ring reduce axial thrust.",
      "material": "Cast iron, bronze, stainless steel (CF8M, CA6NM), duplex.",
      "operating_conditions": "Head varies with tip speed squared; operation far from BEP increases recirculation, vibration and NPSH required.",
      "failure_modes": [
        "Cavitation damage at blade inlet",
        "Erosion",
        "Imbalance",
        "Wear-ring rub"
      ],
      "inspection": [
        "Inlet edges for pitting",
        "Wear-ring clearance",
        "Balance check after repair"
      ]
    },
    "bfp_stage": {
      "function": "One pumping stage: diffuser recovers pressure from the impeller discharge; return vanes guide water to the next impeller eye.",
      "construction": "Cast or forged ring with diffuser vanes, diaphragm and return channel; metal-to-metal fits with O-rings.",
      "material": "Chrome steel (13 % Cr), carbon steel, stainless.",
      "operating_conditions": "Pressure rises stage by stage; thermal transients must be limited (warm-up).",
      "failure_modes": [
        "Erosion at diffuser tips",
        "Interstage leakage"
      ],
      "inspection": [
        "Clearances at overhaul"
      ]
    },
    "bfp_suction": {
      "function": "Receives feedwater from the deaerator/booster and feeds the first-stage impeller.",
      "construction": "Casting with suction nozzle, foot and first-stage eye passage.",
      "material": "Carbon steel/chrome steel.",
      "operating_conditions": "Hot, near-saturated water — low NPSHa.",
      "failure_modes": [
        "Cavitation erosion at first stage"
      ],
      "inspection": [
        "First-stage impeller inspection"
      ]
    },
    "bfp_discharge": {
      "function": "Collects flow from the last stage, carries the discharge nozzle and the balance drum chamber.",
      "construction": "Heavy casting/forging.",
      "material": "Carbon/chrome steel.",
      "operating_conditions": "Full discharge pressure.",
      "failure_modes": [
        "Erosion",
        "Joint leakage"
      ],
      "inspection": [
        "Joint inspection"
      ]
    },
    "bfp_balance": {
      "function": "Throttling bush around the balance drum; leak-off returns to suction to balance thrust.",
      "construction": "Close-clearance bushing.",
      "material": "Bronze/hardened stainless.",
      "operating_conditions": "Wear increases leak-off flow.",
      "failure_modes": [
        "Wear → higher leak-off and thrust"
      ],
      "inspection": [
        "Monitor balance leak-off flow"
      ]
    },
    "bfp_tiebolts": {
      "function": "Clamp the stage stack between suction and discharge casings.",
      "construction": "High-strength studs and nuts, hydraulically tensioned.",
      "material": "Alloy steel.",
      "operating_conditions": "Preload must exceed hydraulic separating force.",
      "failure_modes": [
        "Loss of preload",
        "Thermal relaxation"
      ],
      "inspection": [
        "Tension check per manufacturer"
      ]
    },
    "pump_shaft": {
      "function": "Transmits torque from the coupling to the impeller(s).",
      "construction": "Ground shaft with keyways, threads for impeller nut and bearing locknut; often protected by a sleeve under the seal.",
      "material": "Carbon steel, 4140 alloy steel, 410/420 or 316 stainless, duplex.",
      "operating_conditions": "Stiffness (L3/D4 ratio for overhung pumps) limits deflection at the seal faces.",
      "failure_modes": [
        "Fatigue at keyway or shoulder",
        "Corrosion",
        "Excess deflection when operated far from BEP"
      ],
      "inspection": [
        "Run-out (TIR)",
        "Journal and keyway condition"
      ]
    },
    "bearing_frame": {
      "function": "Holds the shaft bearings and oil or grease, and supports the overhung impeller.",
      "construction": "Cast housing with bearing bores, oil sump with sight glass/constant-level oiler, bearing isolators or lip seals, and foot.",
      "material": "Cast iron or ductile iron.",
      "operating_conditions": "Oil level and cleanliness are critical; bearing isolators keep contaminants out.",
      "failure_modes": [
        "Oil contamination",
        "Overheating",
        "Bearing housing bore wear"
      ],
      "inspection": [
        "Oil level/condition",
        "Bearing temperature",
        "Vibration at housing"
      ]
    },
    "radial_bearing": {
      "function": "Carries radial load near the impeller end.",
      "construction": "Deep-groove or cylindrical roller bearing.",
      "material": "Bearing steel.",
      "operating_conditions": "Oil-bath or grease lubricated.",
      "failure_modes": [
        "Lubrication failure",
        "Contamination",
        "Overload from operation far from BEP"
      ],
      "inspection": [
        "Temperature, vibration, oil analysis"
      ]
    },
    "mechanical_seal": {
      "function": "Seals the rotating shaft where it leaves the pressurised casing.",
      "construction": "Spring-loaded rotating face running against a stationary seat; secondary elastomer seals; cartridge designs are pre-set for easier installation.",
      "material": "Faces: carbon-graphite, silicon carbide, tungsten carbide; metal parts stainless steel; elastomers per fluid.",
      "operating_conditions": "Faces need a stable liquid film; flush or quench piping plans (API 682 plan numbers) are chosen to control temperature, pressure and solids at the faces.",
      "failure_modes": [
        "Dry running",
        "Face wear from abrasives",
        "Thermal cracking",
        "Elastomer chemical attack",
        "Excess shaft run-out or vibration"
      ],
      "inspection": [
        "Leakage rate and seal temperature",
        "Flush flow/pressure where fitted",
        "Shaft run-out at seal chamber"
      ]
    },
    "thrust_bearing": {
      "function": "Carries axial hydraulic thrust and locates the shaft axially.",
      "construction": "Duplex angular-contact ball bearings (back-to-back) or tapered roller bearings.",
      "material": "Bearing steel; brass or polyamide cages.",
      "operating_conditions": "Thrust varies with flow and wear-ring clearance.",
      "failure_modes": [
        "Overload from worn wear rings or balance holes",
        "Lubricant breakdown"
      ],
      "inspection": [
        "Temperature, vibration, axial end play"
      ]
    },
    "coupling_flex": {
      "function": "Transmits torque between motor and pump while accommodating small misalignment and allowing separation for maintenance.",
      "construction": "Two hubs with a flexible element (elastomer spider, pin-and-bush, disc pack or gear); spacer versions allow seal removal without moving the motor.",
      "material": "Steel or cast iron hubs; elastomer or stainless-steel disc elements.",
      "operating_conditions": "Misalignment must still be corrected to manufacturer and pump tolerance; flexible couplings are not a substitute for alignment.",
      "failure_modes": [
        "Element wear or rupture from misalignment",
        "Fretting of hub bores",
        "Loose set screws/keys"
      ],
      "inspection": [
        "Laser or dial alignment after grouting, after piping connection and at operating temperature",
        "Inspect flexible element"
      ]
    },
    "coupling_guard": {
      "function": "Prevents contact with rotating parts.",
      "construction": "Sheet-metal or mesh guard fixed to the baseplate; must be in place before start-up.",
      "material": "Steel, aluminium or non-sparking brass for hazardous areas.",
      "operating_conditions": "Required by machinery safety regulations.",
      "failure_modes": [
        "Guard contacting coupling after damage"
      ],
      "inspection": [
        "Fitted and secure before start"
      ]
    },
    "motor_frame_h": {
      "function": "Encloses the stator and supports the bearings; feet or flange mount the motor to the baseplate or pump.",
      "construction": "Totally enclosed fan-cooled (TEFC) frame with external cooling fins, drive-end and non-drive-end end shields, terminal box and lifting eye.",
      "material": "Cast iron or aluminium frame; steel fasteners.",
      "operating_conditions": "Frame size, enclosure (IP rating), efficiency class (e.g. IEC 60034-30-1 IE3/IE4) and insulation class per motor data sheet.",
      "failure_modes": [
        "Overheating from blocked fins or fan cover",
        "Soft foot causing frame distortion and vibration",
        "Moisture ingress at terminal box"
      ],
      "inspection": [
        "Clean fins and fan cover",
        "Check foot shims for soft foot",
        "Insulation resistance before start-up"
      ]
    },
    "stator": {
      "function": "Produces the rotating magnetic field.",
