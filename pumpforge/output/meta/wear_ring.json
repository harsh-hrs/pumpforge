    "pressure": {
      "file": "wear_ring_pressure.glb",
      "title": "Clearance separates high and low pressure",
      "description": "The impeller discharge pressure acts in the gap between the front shroud and the casing; only the narrow wear-ring clearance separates it from the low-pressure eye. Leakage through the clearance is recirculated inside the pump, wasting energy: as rings wear and clearance doubles, efficiency can fall several points. Typical diametral clearance ≈ 0.25–0.5 mm for 50–150 mm rings (API 610 sets minimums by diameter and material). Replace rings when clearance reaches about twice the new value.",
      "render": "normal",
      "annotations": []
    },
    "wear": {
      "file": "wear_ring_wear.glb",
      "title": "Rubbing surfaces",
      "description": "Wear rings are the sacrificial surfaces: dissimilar, galling-resistant materials and hardness differences are used.",
      "render": "normal",
      "annotations": []
    }
  },
