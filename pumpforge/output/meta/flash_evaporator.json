    "pressure": {
      "file": "flash_evaporator_pressure.glb",
      "title": "Pressure drop causes flashing",
      "description": "The feed is heated under pressure so it does not boil. Passing the pressure-reducing valve into the lower-pressure vessel, it is suddenly above its boiling point at the new pressure: part of it flashes to vapour, and the latent heat taken by that vapour cools the remaining liquid to the saturation temperature of the vessel. Flash fraction ≈ cp·(T_in − T_sat) / h_fg.",
      "render": "normal",
      "annotations": []
    }
