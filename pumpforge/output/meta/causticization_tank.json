    "pressure": {
      "file": "causticization_tank_pressure.glb",
      "title": "Recovering caustic from carbonate",
      "description": "Carbon dioxide picked up by the liquor turns caustic into sodium carbonate, which does nothing useful. Adding slaked lime converts it back: Na₂CO₃ + Ca(OH)₂ → 2 NaOH + CaCO₃↓. The calcium carbonate solids are separated and the regenerated caustic returns to the circuit; conditions (temperature, liquor strength) are chosen to limit alumina losses as calcium aluminates.",
      "render": "normal",
      "annotations": []
    }
