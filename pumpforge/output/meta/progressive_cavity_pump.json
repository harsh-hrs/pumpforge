  "components": {
    "pc_stator": {
      "function": "Forms the double-helix cavity that seals against the rotor; with it, defines the progressing cavities.",
      "construction": "Elastomer moulded and bonded into a steel tube.",
      "material": "NBR, EPDM, FKM, natural rubber; even-wall stators for higher pressure.",
      "operating_conditions": "Interference fit with rotor; must never run dry (heat build-up destroys the elastomer).",
      "failure_modes": [
        "Dry-run burn-out",
        "Swelling/chemical attack",
        "Abrasive wear",
