  "components": {
    "casing": {
      "function": "Pressure-containing outer casing that supports the liners.",
      "construction": "Split cover plate and frame plate bolted around the liners; ribs carry pressure loads.",
      "material": "Ductile or cast iron (not wetted).",
      "operating_conditions": "Liners take the wear; outer casing must stay dry of slurry.",
      "failure_modes": [
