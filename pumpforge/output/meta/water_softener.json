    "pressure": {
      "file": "water_softener_pressure.glb",
      "title": "Hardness exchanged for sodium",
      "description": "Hard water passes down through cation resin in the sodium form: Ca²⁺ and Mg²⁺ are held by the resin and Na⁺ is released, so the water no longer forms scale (outlet hardness typically < 1 mg/L as CaCO₃). When the resin is exhausted it is regenerated with strong brine (NaCl ~ 10 %), which pushes the hardness off again; twin units give continuous soft water.",
      "render": "normal",
      "annotations": []
    }
  },
