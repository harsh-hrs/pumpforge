  "components": {
    "ex_undercarriage": {
      "function": "Carries the machine and lets it travel and stand on soft pit floors.",
      "construction": "Carbody with two track frames; each with front idler, rear drive sprocket on a planetary final drive and hydraulic travel motor, ~8 track rollers, carrier rollers and a chain of cast shoes (~0.8 m wide).",
      "material": "Cast and forged steel.",
      "operating_conditions": "Ground pressure ~ 0.2–0.25 MPa; travel ~ 2–3 km/h.",
      "failure_modes": [
        "Track pin/bushing and roller wear",
        "Final-drive leaks"
      ],
      "inspection": [
        "Measure track sag and wear; check final-drive oil"
      ]
    },
    "ex_swing": {
      "function": "Lets the upper structure rotate 360° on the undercarriage.",
      "construction": "Large three-row roller slewing bearing with an internal ring gear driven by the swing pinions; centre (rotary) joint passes oil to the travel motors.",
      "material": "Forged bearing steel.",
      "operating_conditions": "Swing speed ~ 4–5 rpm (class typical).",
      "failure_modes": [
        "Bearing wear/rocking",
        "Pinion and ring-gear tooth wear"
      ],
      "inspection": [
        "Measure bearing rock (tilt) clearance; grease ring gear"
      ]
    },
    "ex_upper": {
      "function": "Carries the power module, cab, tanks and counterweight; balances the loaded front attachment.",
      "construction": "Welded revolving frame with walkways and handrails; rear counterweight; elevated cab with operator guard; coolers; fuel tank (~3,000–3,500 L); GNSS antennas; auto-lube; fire-suppression bottles.",
      "material": "Steel.",
      "operating_conditions": "Tail-swing radius ~ 5–5.5 m: keep people and vehicles clear of the swing zone.",
      "failure_modes": [
        "Cracks at the boom-foot brackets"
      ],
      "inspection": [
        "Structural inspection of high-stress welds"
      ]
    },
    "ex_power": {
      "function": "Produces and controls the hydraulic power.",
      "construction": "Diesel engine (~700–800 kW class, typically V12/V16) driving a pump drive gearbox with several variable-displacement axial-piston pumps; main control valve blocks; swing motors with planetary reducers.",
      "material": "Cast iron, steel.",
      "operating_conditions": "System pressure up to ~30–32 MPa (class typical).",
      "failure_modes": [
        "Hydraulic contamination",
        "Pump wear → slow cycles"
      ],
      "inspection": [
        "Oil sampling and filter changes; cycle-time checks"
      ]
    },
    "ex_access": {
      "function": "Safe access from the ground to the machine.",
      "construction": "Hydraulically raised and lowered stairway at about 40–45°; interlocked so the machine cannot swing or travel while it is down.",
      "material": "Steel, grating.",
      "operating_conditions": "—",
      "failure_modes": [
        "Interlock faults"
      ],
      "inspection": [
        "Test the interlock daily"
      ]
    },
    "ex_boom": {
      "function": "Lifts the arm and bucket.",
      "construction": "Welded high-strength-steel box section, banana-shaped; pinned to the upper frame at the boom foot and lifted by two boom cylinders.",
      "material": "High-strength steel.",
      "operating_conditions": "Fatigue loading every pass.",
      "failure_modes": [
        "Fatigue cracks at the boom foot and cylinder bosses"
      ],
      "inspection": [
        "NDT of known crack sites"
      ]
    },
    "ex_arm": {
      "function": "Pulls the bucket through the dig (crowd) and reaches out.",
      "construction": "Welded box section pinned to the boom tip; the arm cylinder acts on the crowd lever above the arm pin.",
      "material": "High-strength steel.",
      "operating_conditions": "—",
      "failure_modes": [
        "Cracks, pin and bush wear"
      ],
      "inspection": [
        "Measure pin clearances"
      ]
    },
