  "components": {
    "baseplate": {
      "function": "Provides a rigid common mounting for pump and driver, maintains alignment and transfers loads to the foundation.",
      "construction": "Fabricated steel channel frame with machined mounting pads, grout and vent holes, drip rim/drain, and anchor bolt holes.",
      "material": "Carbon steel, painted; stainless steel for hygienic or corrosive areas.",
      "operating_conditions": "Must be levelled and fully grouted (epoxy or cementitious) to achieve stiffness; ANSI/HI and API 686 give installation practice.",
      "failure_modes": [
        "Voids under the baseplate causing vibration",
        "Soft foot at pads",
        "Corrosion under grout"
      ],
      "inspection": [
        "Tap test for voids",
        "Check levelness and anchor bolt tightness",
        "Verify alignment after grouting"
      ]
    },
    "lo_reservoir": {
      "function": "Stores oil, separates air/water, provides retention time; heater for cold start.",
      "construction": "Stainless tank with sloped bottom, drain, heater, level and temperature instruments.",
      "material": "Stainless steel (often required by API 614).",
      "operating_conditions": "Maintain minimum level and temperature before start.",
      "failure_modes": [
        "Water contamination",
        "Foaming"
      ],
      "inspection": [
        "Oil analysis"
      ]
    },
    "lo_level": {
      "function": "Shows level, breathes air, heats oil for cold start.",
      "construction": "Sight gauge, breather, immersion heater.",
      "material": "—",
      "operating_conditions": "Heater interlocked with level.",
      "failure_modes": [
        "Heater burn-out if exposed"
      ],
      "inspection": [
        "Function test"
      ]
    },
    "lo_pump": {
      "function": "Delivers oil flow to the header; one runs, one stands by.",
      "construction": "Three-screw pump with motor on the console skid.",
      "material": "Cast iron/steel, hardened rotors.",
      "operating_conditions": "Standby auto-start on low header pressure; check valves isolate the idle pump.",
      "failure_modes": [
        "Rotor wear",
        "Loss of suction (low level)"
      ],
      "inspection": [
        "Auto-start test",
        "Vibration"
      ]
    },
    "power_rotor_lo": {
      "function": "Screw rotors that move oil axially without pulsation.",
      "construction": "Power rotor drives two idlers hydraulically.",
      "material": "Hardened steel.",
      "operating_conditions": "Lubricated by the oil itself.",
      "failure_modes": [
        "Wear"
      ],
      "inspection": [
        "Performance trend"
      ]
    },
    "coupling_flex": {
      "function": "Transmits torque between motor and pump while accommodating small misalignment and allowing separation for maintenance.",
      "construction": "Two hubs with a flexible element (elastomer spider, pin-and-bush, disc pack or gear); spacer versions allow seal removal without moving the motor.",
      "material": "Steel or cast iron hubs; elastomer or stainless-steel disc elements.",
      "operating_conditions": "Misalignment must still be corrected to manufacturer and pump tolerance; flexible couplings are not a substitute for alignment.",
      "failure_modes": [
        "Element wear or rupture from misalignment",
        "Fretting of hub bores",
        "Loose set screws/keys"
      ],
      "inspection": [
        "Laser or dial alignment after grouting, after piping connection and at operating temperature",
        "Inspect flexible element"
      ]
    },
    "coupling_guard": {
      "function": "Prevents contact with rotating parts.",
      "construction": "Sheet-metal or mesh guard fixed to the baseplate; must be in place before start-up.",
      "material": "Steel, aluminium or non-sparking brass for hazardous areas.",
      "operating_conditions": "Required by machinery safety regulations.",
      "failure_modes": [
        "Guard contacting coupling after damage"
      ],
      "inspection": [
        "Fitted and secure before start"
      ]
    },
    "motor_frame_h": {
      "function": "Encloses the stator and supports the bearings; feet or flange mount the motor to the baseplate or pump.",
      "construction": "Totally enclosed fan-cooled (TEFC) frame with external cooling fins, drive-end and non-drive-end end shields, terminal box and lifting eye.",
      "material": "Cast iron or aluminium frame; steel fasteners.",
      "operating_conditions": "Frame size, enclosure (IP rating), efficiency class (e.g. IEC 60034-30-1 IE3/IE4) and insulation class per motor data sheet.",
      "failure_modes": [
        "Overheating from blocked fins or fan cover",
        "Soft foot causing frame distortion and vibration",
        "Moisture ingress at terminal box"
      ],
      "inspection": [
        "Clean fins and fan cover",
        "Check foot shims for soft foot",
        "Insulation resistance before start-up"
      ]
    },
    "stator": {
      "function": "Produces the rotating magnetic field.",
      "construction": "Laminated electrical-steel core with insulated copper windings; end turns project at each end.",
      "material": "Silicon electrical steel, copper magnet wire, Class F/H insulation (typical).",
      "operating_conditions": "Rated voltage and frequency; temperature rise within insulation class.",
      "failure_modes": [
        "Winding insulation failure",
        "Single phasing",
        "Overload overheating"
      ],
      "inspection": [
        "Insulation resistance / polarisation index",
        "Phase current balance",
        "Winding temperature where RTDs fitted"
      ]
    },
    "rotor": {
      "function": "Converts the rotating field into shaft torque (squirrel-cage induction rotor).",
      "construction": "Laminated core with aluminium or copper bars and end rings, shrunk on the shaft and dynamically balanced.",
      "material": "Electrical steel, die-cast aluminium or copper.",
      "operating_conditions": "Runs slightly below synchronous speed (slip).",
      "failure_modes": [
        "Broken rotor bars",
        "Imbalance",
        "Rotor-stator rub after bearing failure"
      ],
      "inspection": [
        "Motor current signature analysis",
        "Vibration at 1x and pole-pass sidebands"
      ]
    },
    "motor_bearings": {
      "function": "Support the motor rotor at drive and non-drive ends.",
      "construction": "Deep-groove ball bearings (roller bearing at drive end on larger belt-driven motors); one end locates axially.",
      "material": "Bearing steel; grease lubricated.",
      "operating_conditions": "Regrease interval depends on speed, size and temperature; insulated bearings recommended with VFDs to prevent electrical fluting.",
      "failure_modes": [
        "Lubrication failure",
        "Contamination",
        "Electrical erosion (fluting) with VFDs"
      ],
      "inspection": [
        "Temperature and vibration trend",
        "Regrease per nameplate",
        "High-frequency envelope analysis"
      ]
    },
    "motor_fan": {
      "function": "Draws cooling air over the finned frame.",
      "construction": "Shaft-mounted radial or bidirectional fan at the non-drive end.",
      "material": "Polymer, aluminium or steel.",
      "operating_conditions": "Rotates with the shaft.",
      "failure_modes": [
        "Broken blades",
        "Clogged air inlet"
      ],
      "inspection": [
        "Visual check through fan cover; clean inlet"
      ]
    },
    "fan_cover": {
      "function": "Guards the fan and directs air along the fins.",
      "construction": "Pressed-steel cowl with perforated air inlet.",
      "material": "Steel or polymer.",
      "operating_conditions": "Air inlet must be kept clear (minimum clearance to walls per manufacturer).",
      "failure_modes": [
        "Dents causing fan contact",
        "Blocked inlet"
      ],
      "inspection": [
        "Visual"
      ]
    },
    "pipework": {
      "function": "Connects the pump to the system.",
      "construction": "Flanged pipe spools, fittings and supports; suction piping laid out to give uniform flow into the pump (straight run, eccentric reducers flat side up).",
      "material": "Carbon steel, stainless steel, ductile iron, HDPE/PVC as appropriate.",
      "operating_conditions": "Piping must be supported independently so nozzle loads stay within limits.",
      "failure_modes": [
        "Nozzle overload from unsupported piping",
        "Air pockets in suction",
        "Corrosion"
      ],
      "inspection": [
        "Check supports and flange alignment before bolting to pump"
      ]
    },
    "lo_filter": {
      "function": "Removes particles; one side in service while the other is serviced.",
      "construction": "Duplex filter housings with transfer valve, differential-pressure indicator.",
      "material": "Carbon/stainless housings.",
      "operating_conditions": "Changeover without flow interruption.",
      "failure_modes": [
        "Element clogging",
        "Transfer valve leakage"
      ],
      "inspection": [
        "ΔP monitoring"
      ]
    },
    "lo_cooler": {
      "function": "Removes heat from oil to keep supply temperature constant.",
      "construction": "Twin shell-and-tube coolers with transfer valve; temperature-control valve.",
      "material": "Steel shell, copper-nickel/stainless tubes.",
      "operating_conditions": "Oil pressure should exceed water pressure to avoid water ingress on tube leak.",
      "failure_modes": [
        "Fouling",
        "Tube leaks"
      ],
      "inspection": [
        "Outlet temperature trend"
      ]
    },
    "lo_pcv": {
      "function": "Holds header pressure constant by spilling excess flow back to the tank.",
      "construction": "Self-acting or pneumatic back-pressure control valve; gauges and transmitters.",
      "material": "Steel.",
      "operating_conditions": "Stable header pressure is critical for bearing protection.",
      "failure_modes": [
        "Sticking"
      ],
      "inspection": [
        "Calibration"
      ]
    }
  }
