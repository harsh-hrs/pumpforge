  "summary": "A fire pump package is a complete, listed pumping system that must start automatically and deliver its rated flow and pressure to sprinklers and hydrants whenever system pressure falls. It combines a fire pump (here a horizontal split-case pump), a reliable driver (diesel engine with its own batteries, fuel and cooling from the pump discharge, or an electric motor), a fire pump controller, a small jockey pump that keeps the system pressurised against minor leaks, a main relief valve, a test header for flow testing, and isolation/check valves. Installation and acceptance are governed by fire codes such as NFPA 20.",
  "classification": {
    "family": "Package / system",
    "configuration": "Horizontal split-case fire pump + diesel engine driver + jockey pump + controllers",
    "application": "Fire protection (sprinkler, hydrant, deluge systems)"
  },
  "model_configuration": {
    "performance_rule_note": "Listed fire pumps must deliver ≥150 % of rated flow at ≥65 % of rated pressure, and shut-off ≤140 % of rated pressure (NFPA 20 — verify current edition).",
    "driver": "Diesel engine via drive shaft (electric-motor drives also common)",
    "jockey_pump": "Vertical multistage, small flow, sets pressure-maintenance band"
  },
  "standards": [
    {
      "id": "NFPA 20",
      "title": "Standard for the Installation of Stationary Pumps for Fire Protection",
      "relevance": "Governs fire pump selection, drivers, controllers, piping, testing.",
      "edition": "to be verified (2022 edition current at time of writing; confirm)"
    },
    {
      "id": "NFPA 25",
      "title": "Inspection, Testing and Maintenance of Water-Based Fire Protection Systems",
      "relevance": "Weekly/annual fire pump testing.",
      "edition": "to be verified"
    },
    {
      "id": "UL 448 / FM Class 1311",
      "title": "Listing/approval of fire pumps",
      "relevance": "Pumps, drivers and controllers must be listed/approved.",
      "edition": "to be verified"
    },
    {
      "id": "EN 12845",
      "title": "Fixed firefighting systems — Automatic sprinkler systems",
      "relevance": "European equivalent requirements for pump sets.",
      "edition": "to be verified"
    }
  ],
